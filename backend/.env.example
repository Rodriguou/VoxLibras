# Azure AI Speech credentials (required for live speech recognition; /health works without them).
# Create a Speech resource in the `brazilsouth` region in the Azure Portal for lowest latency.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth

# Speech recognition language and sentence segmentation settings
SPEECH_LANGUAGE=pt-BR
SEGMENTATION_SILENCE_MS=400

# VLibras gloss translator endpoint and per-segment timeout (seconds)
VLIBRAS_TRANSLATOR_URL=https://traducao2.vlibras.gov.br/translate
GLOSS_TIMEOUT_S=3.0

# Allowed WebSocket Origin prefixes (JSON array)
ALLOWED_ORIGIN_PREFIXES=["chrome-extension://"]

# Python logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
